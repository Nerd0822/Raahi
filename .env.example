# Copy to .env at the repo root. This one file configures both local Django
# development and the Docker Compose stack.
SECRET_KEY='generate with: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"'
DEBUG=True

# AI guide — local Ollama by default, serving the gpt-oss cloud model.
# Any OpenAI-compatible /chat/completions endpoint works instead:
#   OpenAI:     https://api.openai.com/v1  (set LLM_API_KEY, model gpt-4o-mini)
#   OpenRouter: https://openrouter.ai/api/v1
# LLM_API_KEY may be blank for local servers that don't check auth.
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gpt-oss:120b-cloud

# Compose: published port and Postgres credentials.
WEB_PORT=8080
POSTGRES_DB=raahi
POSTGRES_USER=raahi
POSTGRES_PASSWORD=raahi

# In Docker, LLM_BASE_URL above points at the host machine's Ollama
# (host.docker.internal). For a remote provider inside the container, set:
# LLM_BASE_URL_DOCKER=https://api.openai.com/v1

# Optional overrides:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# REDIS_URL=redis://127.0.0.1:6379/1
