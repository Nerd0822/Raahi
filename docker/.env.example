# Copy to docker/.env for docker compose. Compose also reads ../Backend/.env
# for the Django secret and AI provider settings.
POSTGRES_DB=raahi
POSTGRES_USER=raahi
POSTGRES_PASSWORD=change-me
WEB_PORT=8080

# Optional Django overrides for the container:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
#
# AI endpoint for the container (Docker only; model and key come from
# Backend/.env). Defaults to Ollama on the host, so run Ollama with
# OLLAMA_HOST=0.0.0.0. For a remote OpenAI-compatible provider set:
# LLM_BASE_URL=https://api.openai.com/v1
